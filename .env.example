# GEMINI_API_KEY: Optional for future expansions
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: Runtime hosting URL
APP_URL="MY_APP_URL"
# PYTHON_PATH: Defaults to python3
PYTHON_PATH="python3"
# Server Port
PORT=3000

# Psychological Storyteller VLM (OpenRouter / Qwen2.5-VL / InternVL2) — never hardcode secrets in source code
OPENROUTER_API_KEY=""
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=qwen/qwen2.5-vl-32b-instruct
VLM_PROVIDER="openrouter"
VLM_API_KEY=""
VLM_API_URL="https://openrouter.ai/api/v1/chat/completions"
VLM_MODEL="qwen/qwen2.5-vl-32b-instruct"
VLM_MODEL_NAME="qwen/qwen2.5-vl-32b-instruct"

# DeepSeek R1 Psychological Thriller Script Generator
DEEPSEEK_API_KEY=""
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL="deepseek-reasoner"
DEEPSEEK_MODEL_NAME=deepseek-reasoner

# Depth Anything V2 Small & Optional Replicate Seedream Poster
ENABLE_DEPTH_ANYTHING=true
ENABLE_DEPTH_ANYTHING_TORCH="0"
REPLICATE_API_TOKEN=""
